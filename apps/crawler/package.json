{
  "name": "@footcast/crawler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "lint": "echo \"no lint yet\""
  },
  "dependencies": {
    "@footcast/article-pipeline": "workspace:*",
    "@footcast/config": "workspace:*",
    "@footcast/database": "workspace:*",
    "@footcast/logger": "workspace:*",
    "@footcast/queue": "workspace:*",
    "@footcast/shared": "workspace:*",
    "fast-xml-parser": "^4.5.1",
    "ioredis": "^5.4.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsc-watch": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
