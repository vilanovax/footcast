# --- Content generation (Claude / Anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Provider selection ---
# tts: mock | elevenlabs   (پیش‌فرض: اگر کلید ElevenLabs باشد elevenlabs، وگرنه mock)
# asr: mock                (Whisper در نسخه بعدی)
# با mock کل پایپلاین بدون کلید و بدون هزینه اجرا می‌شود.
TTS_PROVIDER=mock
ASR_PROVIDER=mock

# --- Text-to-speech (ElevenLabs) ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
# Voice id to use (pick one from your ElevenLabs voice library).
# The default below is "Rachel" — replace with a voice that reads Persian well.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Multilingual model that supports Persian/Farsi.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
