# --- Content generation (Claude / Anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Provider selection ---
# tts: mock | elevenlabs
# asr: mock                (Whisper در نسخه بعدی)
# با mock کل پایپلاین بدون کلید و بدون هزینه اجرا می‌شود.
# برای تولید صوت واقعی، این را روی elevenlabs بگذار و کلید را وارد کن.
TTS_PROVIDER=elevenlabs
ASR_PROVIDER=mock

# --- Text-to-speech (ElevenLabs) ---
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
# صدای برنامه (قابل تغییر با هر صدای دلخواه از کتابخانه‌ی تو).
ELEVENLABS_VOICE_ID=pqHfZKP75CvOlQylNhV4
# مدل: eleven_v3 (جدید) یا eleven_multilingual_v2 (پایدار، پشتیبانی فارسی).
# اگر v3 برای کلیدت در دسترس نبود یا خطا داد، به multilingual_v2 برگرد.
ELEVENLABS_MODEL_ID=eleven_v3
